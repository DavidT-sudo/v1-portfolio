# Contact channels — server-side only, never shipped to the client.
# WhatsApp number: digits only, with country code, no "+" (wa.me format)
WHATSAPP_NUMBER=26700000000
CONTACT_EMAIL=you@example.com

# Optional: send email server-side via https://resend.com instead of
# falling back to a mailto: link. RESEND_FROM must be a verified sender.
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=portfolio@yourdomain.com

# Optional: Cloudflare Turnstile bot challenge on the contact form.
# When both are set the widget renders and the server verifies the token;
# when unset, the form works without a challenge (dev/local).
# The SITE key is public (NEXT_PUBLIC_); the SECRET key is server-only.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...
